{
  "name": "flyvip/cms",
  "description": "FlyVIP private-jet membership CMS (CodeIgniter 4)",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.4",
    "codeigniter4/framework": "^4.7",
    "codeigniter4/shield": "^1.2"
  },
  "require-dev": {
    "codeigniter/phpstan-codeigniter": "^1.0",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.65",
    "mikey179/vfsstream": "^1.6",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Support\\": "tests/_support"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
    "rector": "rector process",
    "rector-dry": "rector process --dry-run",
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text",
    "coverage-gate": "php tests/coverage-gate.php 55",
    "lint-frontend": "npm run lint --silent",
    "e2e": "npm run test:e2e",
    "visual": "npm run test:visual",
    "quality": [
      "@cs-check",
      "@phpstan",
      "@rector-dry",
      "@test",
      "@coverage-gate",
      "@lint-frontend"
    ]
  }
}
